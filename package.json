{
  "name": "@summerscar/dsh-mnemon-sync",
  "version": "0.1.5",
  "description": "Back up and restore dsh-mnemon memory components (memory spaces, project documents, runtime memory) to S3-compatible storage or WebDAV.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./source": "./source.js"
  },
  "files": [
    "index.js",
    "source.js",
    "client.js",
    "store.js",
    "snapshot.js",
    "scheduler.js",
    "targets.js",
    "zip.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "cordis",
    "dsh-mnemon",
    "mnemon",
    "agent-memory",
    "backup",
    "restore",
    "memory",
    "sqlite",
    "webdav",
    "s3",
    "cloudflare-r2"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.16",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "dsh-mnemon": ">=0.5.40"
  },
  "peerDependenciesMeta": {
    "dsh-mnemon": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "dsh-mnemon/client"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/summerscar/dsh-mnemon-sync.git"
  },
  "bugs": {
    "url": "https://github.com/summerscar/dsh-mnemon-sync/issues"
  },
  "homepage": "https://github.com/summerscar/dsh-mnemon-sync#readme",
  "publishConfig": {
    "access": "public"
  }
}
