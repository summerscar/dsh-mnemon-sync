{
  "name": "@summerscar/dsh-mnemon-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Back up and restore dsh-mnemon memory components (memory spaces, project documents, runtime memory) to S3-compatible storage or WebDAV.",
  "keywords": [
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh-plugin",
    "dsh-mnemon",
    "mnemon",
    "backup",
    "restore",
    "webdav",
    "s3"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "source.js",
    "client.js",
    "store.js",
    "snapshot.js",
    "scheduler.js",
    "targets.js",
    "zip.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "dsh-mnemon/client"
      ]
    }
  }
}
